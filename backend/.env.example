# Copy to .env and fill in as needed. Never commit a real .env file.

# --- AI reasoning layer ---
# "template" = deterministic offline provider (default, no credentials needed)
# "watsonx"  = real IBM watsonx.ai / Granite (requires the four vars below)
EXPLANATION_PROVIDER=template

GRANITE_API_KEY=
GRANITE_PROJECT_ID=
GRANITE_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
# Wildcard CORS is opt-in only; never set true in production.
CORS_ALLOW_ALL=false

# --- Auth placeholder (NOT wired to any endpoint in this build) ---
JWT_SECRET=change-me-if-auth-is-ever-wired-up

# --- MongoDB (NOT used in this build -- in-memory store is active instead) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=missionguard
